# =============================================================================
# CodeXomics .gitignore
# =============================================================================
# Dependencies
node_modules/
packages/*/node_modules/
jspm_packages/

# Lock files (keep root package-lock.json, ignore workspace locks)
packages/*/package-lock.json
yarn.lock
pnpm-lock.yaml

# =============================================================================
# Build & Distribution
# =============================================================================

# Build outputs
dist/
build/Release
docs/build/
site/

# Electron build artifacts
*.dmg
*.exe
*.deb
*.rpm
*.snap
*.AppImage
build/icons/*.png
build/icon.icns
build/icon.ico
build/background.png

# Packaged archives
*.zip
*.tar.gz
*.tgz
*.rar
*.7z

# =============================================================================
# Runtime & Cache
# =============================================================================

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage
coverage/
.nyc_output

# Playwright / E2E
test-results/
playwright-report/
playwright/.cache/

# Caches
.npm
.eslintcache
.cache
.parcel-cache
.node_repl_history
.yarn-integrity

# Instrumented libs
lib-cov

# =============================================================================
# Environment & Configuration
# =============================================================================

# Environment files
.env
.env.local
.env.test
.env.production

# Local config with sensitive data
config/local.json
config/production.json

# =============================================================================
# OS Generated Files
# =============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk
*.stackdump

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# =============================================================================
# Editor & IDE
# =============================================================================

# VS Code
.vscode/
*.code-workspace

# JetBrains IDEs
.idea/
*.iml
*.ipr
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
*.swp
*.swo

# Emacs
\#*\#
.emacs.desktop
.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# =============================================================================
# Application Specific
# =============================================================================

# Marketplace server uploads (keep structure, ignore files)
packages/marketplace-server/marketplace-data/uploads/*
!packages/marketplace-server/marketplace-data/uploads/.gitkeep
marketplace-data/uploads/*
!marketplace-data/uploads/.gitkeep

# Sample & test data
sample_data/
test_data/
sample-files/

# Database files
*.db
*.sqlite
*.sqlite3

# Backup files
*.bak
*.backup
*.old

# =============================================================================
# AI Assistant Directories
# =============================================================================

.codebuddy/
.workbuddy/
.qoder/
.minimax/
.cursor/
.codeartsdoer/
.arts/

# =============================================================================
# Project Specific
# =============================================================================

# Local testing & development
create-basic-icons.sh
create-demo-icons.sh
download_ecoli_operon_data.py
ecoli_operons_*.csv
ecoli_operons_*.json
ecoli_operons_*.txt
css.check.results
draft

# Design files
design.svg
design-*.svg
test-simple-mode-style-consistency.html

# Manuscript (if not needed in repo)
manuscript/

# Generated documentation reports (keep source, ignore generated)
docs/reports/dynamic-tool-registry-multiagent-integration-report.md

