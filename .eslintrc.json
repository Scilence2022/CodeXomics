{
  "extends": ["eslint:recommended", "google"],
  "env": {
    "browser": true,
    "node": true,
    "es2021": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "globals": {
    "ipcRenderer": "readonly",
    "path": "readonly",
    "gc": "readonly",
    "d3": "readonly",
    "marked": "readonly",
    "DOMPurify": "readonly",
    "Papa": "readonly",
    "ActivationEventsService": "readonly",
    "AgentBase": "readonly",
    "AnalysisAgent": "readonly",
    "AnnotationChangeTracker": "readonly",
    "AutomaticComplexSuite": "readonly",
    "AutomaticSimpleSuite": "readonly",
    "BamReader": "readonly",
    "BenchmarkEvaluatorBase": "readonly",
    "BenchmarkReportGenerator": "readonly",
    "BenchmarkStatistics": "readonly",
    "BenchmarkUI": "readonly",
    "BlastFunctionTools": "readonly",
    "CanvasGenesRenderer": "readonly",
    "CanvasReadsRenderer": "readonly",
    "CanvasSequenceRenderer": "readonly",
    "ChatBoxSettingsManager": "readonly",
    "ChatManager": "readonly",
    "CommandRegistry": "readonly",
    "ContributionRegistry": "readonly",
    "CoordinatorAgent": "readonly",
    "DataAgent": "readonly",
    "DeepResearchAgent": "readonly",
    "Disposable": "readonly",
    "DynamicToolsSnapshotAdapter": "readonly",
    "ExtensionContext": "readonly",
    "ExtensionContextFactory": "readonly",
    "ExtensionHost": "readonly",
    "ExtensionHostKind": "readonly",
    "ExtensionMode": "readonly",
    "ExtensionService": "readonly",
    "ExternalAgent": "readonly",
    "FeatureGlyphLegend": "readonly",
    "FunctionCallsOrganizer": "readonly",
    "GeneShapeCreators": "readonly",
    "LLMBenchmarkFramework": "readonly",
    "LLMConfigManager": "readonly",
    "LLMStreamClient": "readonly",
    "LiteratureAPIService": "readonly",
    "MCPServerManager": "readonly",
    "ManifestBuilder": "readonly",
    "ManifestParser": "readonly",
    "ManualComplexSuite": "readonly",
    "ManualSuite": "readonly",
    "MemorySystem": "readonly",
    "ModalDragManager": "readonly",
    "MultiAgentSystem": "readonly",
    "MultiTrackGeneManager": "readonly",
    "NavigationAgent": "readonly",
    "PluginAPI": "readonly",
    "PluginAgent": "readonly",
    "PluginDemoGenerator": "readonly",
    "PluginDependencyResolver": "readonly",
    "PluginFunctionCallsIntegrator": "readonly",
    "PluginManagementUI": "readonly",
    "PluginManagerBridge": "readonly",
    "PluginManagerV2": "readonly",
    "PluginMarketplace": "readonly",
    "PluginMarketplaceConfig": "readonly",
    "PluginMarketplaceUI": "readonly",
    "PluginRealTestDemonstrator": "readonly",
    "PluginResourceManager": "readonly",
    "PluginSecurityValidator": "readonly",
    "PluginSubmissionUI": "readonly",
    "PluginTestFramework": "readonly",
    "PluginTestHelpers": "readonly",
    "PluginTestManager": "readonly",
    "PluginUpdateManager": "readonly",
    "PluginUtils": "readonly",
    "PrimerTrackSettingsPanel": "readonly",
    "ProjectXMLHandler": "readonly",
    "ResizableModalManager": "readonly",
    "SmartExecutor": "readonly",
    "ToolExecutionTracker": "readonly",
    "TrackRenderer": "readonly",
    "VariantAnalyzer": "readonly",
    "WelcomeExamplesManager": "readonly"
  },
  "rules": {
    "require-jsdoc": "off",
    "valid-jsdoc": "off",
    "eol-last": "off",
    "no-invalid-this": "off",
    "camelcase": "off",
    "no-redeclare": ["error", { "builtinGlobals": false }],
    "no-tabs": "off",
    "brace-style": "off",
    "no-empty": ["error", { "allowEmptyCatch": true }],
    "no-unused-vars": [
      "error",
      { "args": "none", "caughtErrors": "none", "varsIgnorePattern": "^_", "ignoreRestSiblings": true }
    ],
    "max-len": "off",
    "no-console": "off",
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-new-func": "error",
    "no-inner-declarations": "error",
    "no-constant-binary-expression": "error",
    "no-duplicate-imports": "error",
    "no-self-compare": "error",
    "no-template-curly-in-string": "warn",
    "no-unmodified-loop-condition": "warn",
    "no-unreachable-loop": "error",
    "prefer-const": "warn",
    "eqeqeq": ["warn", "smart"],
    "curly": ["warn", "multi-line"],
    "no-var": "warn",
    "no-throw-literal": "error",
    "indent": "off",
    "object-curly-spacing": "off",
    "operator-linebreak": "off",
    "arrow-parens": "off",
    "comma-dangle": "off",
    "quotes": "off",
    "quote-props": "off",
    "space-before-function-paren": "off"
  },
  "overrides": [
    {
      "files": ["test/**/*.js"],
      "env": {
        "jest": true
      }
    }
  ],
  "ignorePatterns": ["node_modules/", "dist/", "build/", "docs/", "site/", "scripts/marketplace-data/", "packages/"]
}
