{
  "name": "codexomics",
  "version": "0.722.0",
  "description": "An AI-powered bioinformatics analysis platform built with Electron",
  "main": "src/main.js",
  "homepage": "https://github.com/Scilence2022/CodeXomics",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "mcp-server": "node scripts/start-mcp-server.js",
    "codexomics-mcp-server": "node scripts/start-mcp-server.js",
    "start-with-mcp": "concurrently \"npm run mcp-server\" \"npm start\"",
    "start-with-claude-mcp": "concurrently \"npm run codexomics-mcp-server\" \"npm start\"",
    "marketplace:start": "npm run start --workspace=packages/marketplace-server",
    "marketplace:dev": "npm run dev --workspace=packages/marketplace-server",
    "marketplace:install": "npm install --workspace=packages/marketplace-server",
    "start-with-marketplace": "concurrently \"npm run marketplace:start\" \"npm start\"",
    "start-full": "concurrently \"npm run mcp-server\" \"npm run marketplace:start\" \"npm start\"",
    "version-sync": "node scripts/update-version.js",
    "version-validate": "node scripts/validate-versions.js",
    "docs:serve": "mkdocs serve",
    "docs:build": "mkdocs build --strict",
    "docs:validate": "node scripts/validate-documentation.js && mkdocs build --strict",
    "docs:deploy": "mkdocs gh-deploy --force",
    "tool-registry:generate": "node scripts/generate-tool-registry-manifest.js",
    "tool-registry:validate": "node scripts/validate-tool-registry-consistency.js",
    "generate-dmg-bg": "node scripts/generate-dmg-svg.js && node scripts/convert-svg-to-png.js",
    "prebuild": "npm run version-sync && npm run tool-registry:generate && npm run generate-dmg-bg",
    "build": "electron-builder",
    "build:mac": "npm run generate-dmg-bg && electron-builder --mac",
    "build:win": "electron-builder --win --x64",
    "build:linux": "electron-builder --linux",
    "build:all": "npm run generate-dmg-bg && electron-builder --mac --win --linux",
    "dist": "electron-builder --publish=never",
    "pack": "electron-builder --dir",
    "pack:mac": "npm run generate-dmg-bg && electron-builder --mac --dir",
    "pack:win": "electron-builder --win --dir",
    "pack:linux": "electron-builder --linux --dir",
    "postinstall": "electron-builder install-app-deps",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "keywords": [
    "bioinformatics",
    "omics",
    "genomics",
    "bioinformatics",
    "electron",
    "genomics",
    "dna",
    "sequence-analysis",
    "artificial-intelligence",
    "machine-learning"
  ],
  "author": {
    "name": "Lifu Song",
    "email": "songlf@tib.cas.cn"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Scilence2022/CodeXomics.git"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@electron/notarize": "^2.5.0",
    "@playwright/test": "^1.60.0",
    "@vitest/coverage-v8": "^4.1.8",
    "concurrently": "^8.2.2",
    "electron": "41.7.1",
    "electron-builder": "^25.1.8",
    "eslint": "^8.57.1",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-electron": "^7.0.0",
    "eslint-plugin-security": "^2.1.1",
    "husky": "^9.1.7",
    "jsdom": "^24.1.3",
    "lint-staged": "^16.4.0",
    "prettier": "^3.7.4",
    "sharp": "^0.34.4",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@gmod/bam": "^6.0.4",
    "@gmod/bbi": "^8.1.0",
    "@modelcontextprotocol/sdk": "^1.15.1",
    "adm-zip": "^0.5.16",
    "call-bind-apply-helpers": "^1.0.2",
    "cors": "^2.8.5",
    "d3": "^7.8.5",
    "dompurify": "^3.4.2",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "express": "^4.22.1",
    "file-saver": "^2.0.5",
    "generic-filehandle": "^3.4.0",
    "generic-filehandle2": "^2.0.16",
    "i18next": "^25.8.0",
    "i18next-fs-backend": "^2.6.1",
    "js-yaml": "^4.1.0",
    "marked": "^9.1.6",
    "multer": "^2.0.2",
    "ngl": "^2.3.1",
    "papaparse": "^5.4.1",
    "ws": "^8.14.2"
  },
  "lint-staged": {
    "src/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "test/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "tools_registry/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "build": {
    "appId": "com.codexomics.app",
    "productName": "CodeXomics",
    "copyright": "Copyright © 2026 ${author}",
    "publish": [
      {
        "provider": "github",
        "owner": "Scilence2022",
        "repo": "CodeXomics"
      }
    ],
    "afterPack": "build/after-pack.js",
    "afterSign": "build/notarize.js",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "tools_registry/**/*",
      "node_modules/**/*",
      "!node_modules/.cache/**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ],
    "extraResources": [
      {
        "from": "test_data",
        "to": "test_data",
        "filter": [
          "**/*"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": "gbk",
        "name": "GenBank Sequence File",
        "description": "GenBank genome sequence file",
        "role": "Editor",
        "icon": "build/icons/512x512.png",
        "mimeType": "chemical/x-genbank"
      },
      {
        "ext": "gb",
        "name": "GenBank Sequence File",
        "description": "GenBank genome sequence file",
        "role": "Editor",
        "icon": "build/icons/512x512.png",
        "mimeType": "chemical/x-genbank"
      }
    ],
    "mac": {
      "category": "public.app-category.education",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "${productName} ${version}",
      "icon": "build/icon.icns",
      "iconSize": 90,
      "window": {
        "width": 660,
        "height": 420,
        "x": 200,
        "y": 200
      },
      "contents": [
        {
          "x": 180,
          "y": 210,
          "type": "file"
        },
        {
          "x": 480,
          "y": 210,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "background": "build/background.png",
      "format": "UDZO",
      "writeUpdateInfo": false,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icons/512x512.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "publisherName": "CodeXomics Team"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "${productName}",
      "perMachine": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "snap",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons/",
      "category": "Science",
      "synopsis": "AI-powered genome analysis studio",
      "description": "An intelligent and user-friendly genome analysis studio built with Electron, featuring AI-powered search and analysis capabilities. Supports FASTA, GenBank, GFF, BED, VCF, and SAM/BAM files for comprehensive genomic research."
    },
    "snap": {
      "publish": {
        "provider": "snapStore",
        "channels": [
          "edge"
        ]
      }
    }
  }
}
